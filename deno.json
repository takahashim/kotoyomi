{
  "tasks": {
    "check": "deno check src/main.ts src/ruby_runtime.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@^1.0.12/file-server",
    "build": "deno bundle src/main.ts -o dist/app.js"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns", "es2022"],
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["spec.md"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": ["dist/"]
}
