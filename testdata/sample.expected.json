  { "id": "line-8", "time": 8.9, "text": "見上げた肩に" },
  { "id": "line-9", "time": 10.1, "text": "やわらかな影がゆらぎ" },
  { "id": "line-10", "time": 12.05, "text": "しずかに消える" }
